# Local .terraform directories
**/.terraform/*

# Terraform state files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Terraform variable files (potentially sensitive)
*.tfvars
*.tfvars.json

# Terraform override files (often for local development)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform plan files
# If you save plans to files, you might want to ignore them
# *tfplan*

# Terraform CLI configuration files
.terraformrc
terraform.rc

# Operating system specific files
.DS_Store
.terraform/
.terraform.lock.hcl